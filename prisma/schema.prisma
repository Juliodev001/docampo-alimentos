generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String           @id @default(cuid())
  name      String
  email     String           @unique
  password  String
  role      UserRole         @default(DONO)
  ativo     Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  colheitas ColheitaDiaria[]
  saidas    SaidaLavoura[]
}

model Produto {
  id               String           @id @default(cuid())
  nome             String
  descricao        String?
  sku              String?
  preco            Decimal          @default(0) @db.Decimal(12, 4)
  precoVenda       Decimal          @default(0) @db.Decimal(12, 4)
  precoPromocional Decimal          @default(0) @db.Decimal(12, 4)
  precoPdv         Decimal          @default(0) @db.Decimal(12, 4)
  unidade          UnidadeMedida    @default(CAIXA)
  categoria        String?
  fornecedorId     String?
  fornecedor       Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  localizacao      String?
  estoqueMinimo    Float            @default(0)
  estoqueMaximo    Float            @default(0)
  ncm              String?
  cest             String?
  cfop             String?
  peso             Float?
  altura           Float?
  largura          Float?
  dataValidade     DateTime?
  observacao       String?
  ativo                Boolean          @default(true)
  estoqueVinculadoId   String?
  estoqueVinculado     Produto?         @relation("EstoqueVinculo", fields: [estoqueVinculadoId], references: [id])
  vinculados           Produto[]        @relation("EstoqueVinculo")
  createdAt            DateTime         @default(now())
  colheitas            ColheitaDiaria[]
  saidas               SaidaLavoura[]
  entradas             EntradaEstoque[]
}

model EntradaEstoque {
  id         String        @id @default(cuid())
  produtoId  String
  produto    Produto       @relation(fields: [produtoId], references: [id])
  quantidade Float
  valorUnit  Decimal       @db.Decimal(12, 4)
  data       DateTime      @default(now())
  observacao String?
  createdAt  DateTime      @default(now())
}

model ColheitaDiaria {
  id                 String        @id @default(cuid())
  data               DateTime
  rocaId             String?
  roca               ControleRoca? @relation(fields: [rocaId], references: [id])
  produtoId          String
  produto            Produto       @relation(fields: [produtoId], references: [id])
  produtorId         String?
  produtor           Produtor?     @relation(fields: [produtorId], references: [id])
  parceiroId         String?
  parceiro           Parceiro?     @relation(fields: [parceiroId], references: [id])
  percDono           Float         @default(60)
  percParceiro       Float         @default(40)
  quantidadeTotal    Float
  quantidadeDono     Float
  quantidadeParceiro Float
  preco              Decimal       @default(0) @db.Decimal(12, 4)
  qualidade          String?
  descarte           Float         @default(0)
  bandeja            Decimal       @default(0) @db.Decimal(12, 4)
  nrDoc              String?
  responsavelId      String
  responsavel        User          @relation(fields: [responsavelId], references: [id])
  observacao         String?
  aprovado           Boolean       @default(true)
  createdAt          DateTime      @default(now())
}

model SaidaLavoura {
  id            String   @id @default(cuid())
  data          DateTime
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  quantidade    Float
  valorUnit     Decimal  @db.Decimal(12, 4)
  totalValor    Decimal  @db.Decimal(12, 4)
  responsavelId String
  responsavel   User     @relation(fields: [responsavelId], references: [id])
  observacao    String?
  createdAt     DateTime @default(now())
}

model CentroCusto {
  id      String   @id @default(cuid())
  nome    String
  compras Compra[]
}

model TipoCusto {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fornecedor {
  id                String               @id @default(cuid())
  nome              String
  tipo              String               @default("JURIDICA")
  cnpjCpf           String?
  inscricaoEstadual String?
  telefone          String?
  email             String?
  ativo             Boolean              @default(true)
  createdAt         DateTime             @default(now())
  produtos          Produto[]
  compras           Compra[]
  nfes              NotaFiscal[]
  pedidos           Pedido[]
  enderecos         FornecedorEndereco[]
  contatos          FornecedorContato[]
}

model FornecedorEndereco {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?
  referencia   String?
  createdAt    DateTime   @default(now())
}

model FornecedorContato {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  telefone     String?
  email        String?
  nomeContato  String?
  observacao   String?
  createdAt    DateTime   @default(now())
}

model Compra {
  id             String            @id @default(cuid())
  data           DateTime
  fornecedorId   String
  fornecedor     Fornecedor        @relation(fields: [fornecedorId], references: [id])
  categoria      CategoriaCompra   @default(MATERIA_PRIMA)
  centroCustoId  String?
  centroCusto    CentroCusto?      @relation(fields: [centroCustoId], references: [id])
  observacao     String?
  condicao       CondicaoPagamento @default(A_VISTA)
  vencimento     DateTime
  formaPagamento FormaPagamento    @default(PIX)
  status         StatusPagamento   @default(A_PAGAR)
  totalValor     Decimal           @default(0) @db.Decimal(12, 4)
  itens          ItemCompra[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model ItemCompra {
  id         String        @id @default(cuid())
  compraId   String
  compra     Compra        @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produto    String
  unidade    UnidadeMedida @default(CAIXA)
  quantidade Float
  valorUnit  Decimal       @db.Decimal(12, 4)
  total      Decimal       @db.Decimal(12, 4)
}

model RegistroProducao {
  id         String            @id @default(cuid())
  data       DateTime
  descricao  String
  observacao String?
  status     StatusProducao    @default(RASCUNHO)
  entradas   EntradaProducao[]
  saidas     SaidaProducao[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model EntradaProducao {
  id                 String           @id @default(cuid())
  registroProducaoId String
  registroProducao   RegistroProducao @relation(fields: [registroProducaoId], references: [id], onDelete: Cascade)
  produto            String
  unidade            UnidadeMedida    @default(CAIXA)
  quantidade         Float
  custoUnit          Decimal          @db.Decimal(12, 4)
  total              Decimal          @db.Decimal(12, 4)
}

model SaidaProducao {
  id                 String           @id @default(cuid())
  registroProducaoId String
  registroProducao   RegistroProducao @relation(fields: [registroProducaoId], references: [id], onDelete: Cascade)
  produto            String
  unidade            UnidadeMedida    @default(CAIXA)
  quantidade         Float
  custoUnit          Decimal          @db.Decimal(12, 4)
  total              Decimal          @db.Decimal(12, 4)
}

model Produtor {
  id                String                 @id @default(cuid())
  codigo            String?                @unique
  nome              String
  tipo              String                 @default("FISICA")
  cpf               String?                @unique
  cnpj              String?
  inscricaoEstadual String?
  telefone          String?
  endereco          String?
  parceiros         Parceiro[]
  colheitas         ColheitaDiaria[]
  fechamentos       FechamentoPagamento[]
  rocas             ControleRoca[]
  vales             Vale[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model FechamentoPagamento {
  id                String   @id @default(cuid())
  produtorId        String
  produtor          Produtor @relation(fields: [produtorId], references: [id])
  dataInicio        DateTime
  dataFim           DateTime
  dataPagamento     DateTime
  valorBruto        Decimal? @db.Decimal(12, 4)
  valorPago         Decimal? @db.Decimal(12, 4)
  combustivel       Decimal  @default(0) @db.Decimal(12, 4)
  bandejaEmbalagem  Decimal  @default(0) @db.Decimal(12, 4)
  valesDinheiro     Decimal  @default(0) @db.Decimal(12, 4)
  creditos          Decimal  @default(0) @db.Decimal(12, 4)
  debitosAnteriores Decimal  @default(0) @db.Decimal(12, 4)
  status            String   @default("PENDENTE")
  vales             Vale[]
  createdAt         DateTime @default(now())
}

model Parceiro {
  id              String             @id @default(cuid())
  codigo          String?            @unique
  produtorId      String
  produtor        Produtor           @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  nome            String
  nomeFantasia    String?
  cpf             String?
  chavePix        String?
  percentual      Float
  valorEmba       Decimal            @default(0) @db.Decimal(12, 4)
  endereco        String?
  telefone        String?
  colheitas       ColheitaDiaria[]
  pagamentos      PagamentoMeeiro[]
  vales           Vale[]
  fechamentos     FechamentoMeeiro[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}

model PagamentoMeeiro {
  id                 String            @id @default(cuid())
  parceiroId         String
  parceiro           Parceiro          @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  valor              Decimal           @db.Decimal(12, 4)
  formaPag           String            @default("PIX")
  conta              String?
  dataPag            DateTime
  observacao         String?
  status             String            @default("CONFIRMADO")
  fechamentoMeeiroId String?
  fechamentoMeeiro   FechamentoMeeiro? @relation(fields: [fechamentoMeeiroId], references: [id])
  createdAt          DateTime          @default(now())
}

model Vale {
  id                 String               @id @default(cuid())
  produtorId         String?
  produtor           Produtor?            @relation(fields: [produtorId], references: [id])
  parceiroId         String?
  parceiro           Parceiro?            @relation(fields: [parceiroId], references: [id])
  valor              Decimal              @db.Decimal(12, 4)
  data               DateTime
  observacao         String?
  status             String               @default("ABERTO")
  fechamentoId       String?
  fechamento         FechamentoPagamento? @relation(fields: [fechamentoId], references: [id])
  fechamentoMeeiroId String?
  fechamentoMeeiro   FechamentoMeeiro?    @relation(fields: [fechamentoMeeiroId], references: [id])
  createdAt          DateTime             @default(now())
}

model FechamentoMeeiro {
  id                String   @id @default(cuid())
  parceiroId        String
  parceiro          Parceiro @relation(fields: [parceiroId], references: [id])
  dataInicio        DateTime
  dataFim           DateTime
  dataPagamento     DateTime
  valorBruto        Decimal  @db.Decimal(12, 4)
  combustivel       Decimal  @default(0) @db.Decimal(12, 4)
  bandejaEmbalagem  Decimal  @default(0) @db.Decimal(12, 4)
  valesDinheiro     Decimal  @default(0) @db.Decimal(12, 4)
  creditos          Decimal  @default(0) @db.Decimal(12, 4)
  debitosAnteriores Decimal  @default(0) @db.Decimal(12, 4)
  valesDeduzidos    Decimal  @default(0) @db.Decimal(12, 4)
  valorPago         Decimal  @db.Decimal(12, 4)
  status            String   @default("PENDENTE")
  observacao        String?
  vales             Vale[]
  pagamentos        PagamentoMeeiro[]
  createdAt         DateTime @default(now())
}

model Cliente {
  id                String             @id @default(cuid())
  nome              String
  tipo              String             @default("FISICA")
  cnpjCpf           String?
  inscricaoEstadual String?
  telefone          String?
  email             String?
  createdAt         DateTime           @default(now())
  nfes              NotaFiscal[]
  devolucoes        Devolucao[]
  romaneios         Romaneio[]
  titulos           TituloFinanceiro[]
  pedidos           Pedido[]
  enderecos         ClienteEndereco[]
  contatos          ClienteContato[]
}

model ClienteEndereco {
  id         String   @id @default(cuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cep        String?
  logradouro String?
  numero     String?
  complemento String?
  bairro     String?
  cidade     String?
  estado     String?
  referencia String?
  createdAt  DateTime @default(now())
}

model ClienteContato {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  telefone    String?
  email       String?
  nomeContato String?
  observacao  String?
  createdAt   DateTime @default(now())
}

model Romaneio {
  id         String         @id @default(cuid())
  numero     Int
  clienteId  String
  cliente    Cliente        @relation(fields: [clienteId], references: [id])
  data       DateTime
  status     StatusRomaneio @default(EMITIDO)
  totalValor Decimal        @default(0) @db.Decimal(12, 4)
  observacao String?
  itens      ItemRomaneio[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ItemRomaneio {
  id         String        @id @default(cuid())
  romaneioId String
  romaneio   Romaneio      @relation(fields: [romaneioId], references: [id], onDelete: Cascade)
  produto    String
  unidade    UnidadeMedida @default(CAIXA)
  quantidade Float
  valorUnit  Decimal       @db.Decimal(12, 4)
  total      Decimal       @db.Decimal(12, 4)
}

model TituloFinanceiro {
  id            String       @id @default(cuid())
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  descricao     String
  valor         Decimal      @db.Decimal(12, 4)
  dataEmissao   DateTime     @default(now())
  dataVenc      DateTime
  dataPagamento DateTime?
  status        StatusTitulo @default(A_RECEBER)
  origem        OrigemTitulo @default(MANUAL)
  nfeId         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model NotaFiscal {
  id               String           @id @default(cuid())
  numero           String?
  serie            String?          @default("1")
  clienteId        String
  cliente          Cliente          @relation(fields: [clienteId], references: [id])
  fornecedorId     String?
  fornecedor       Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  dataEmissao      DateTime         @default(now())
  dataVencimento   DateTime?
  ambiente         AmbienteNF       @default(PRODUCAO)
  status           StatusNF         @default(RASCUNHO)
  chaveAcesso      String?
  totalValor       Decimal          @default(0) @db.Decimal(12, 4)
  itens            ItemNF[]
  statusFinanceiro StatusFinanceiro @default(A_RECEBER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ItemNF {
  id           String        @id @default(cuid())
  notaFiscalId String
  notaFiscal   NotaFiscal    @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  produto      String
  unidade      UnidadeMedida @default(CAIXA)
  quantidade   Float
  valorUnit    Decimal       @db.Decimal(12, 4)
  total        Decimal       @db.Decimal(12, 4)
  ncm          String?
  cfop         String?
}

model Devolucao {
  id           String          @id @default(cuid())
  clienteId    String
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  nfReferencia String?
  data         DateTime
  totalValor   Decimal         @default(0) @db.Decimal(12, 4)
  formaAcerto  FormaAcerto     @default(ABATIMENTO)
  status       StatusDevolucao @default(PENDENTE)
  observacao   String?
  itens        ItemDevolucao[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ItemDevolucao {
  id          String        @id @default(cuid())
  devolucaoId String
  devolucao   Devolucao     @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  produto     String
  unidade     UnidadeMedida @default(CAIXA)
  quantidade  Float
  valorUnit   Decimal       @db.Decimal(12, 4)
  total       Decimal       @db.Decimal(12, 4)
}

model ContaBancaria {
  id            String           @id @default(cuid())
  nome          String
  tipo          TipoConta        @default(CONTA_CORRENTE)
  saldoInicial  Decimal          @default(0) @db.Decimal(12, 4)
  movimentacoes Movimentacao[]
  createdAt     DateTime         @default(now())
}

model Movimentacao {
  id              String           @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria    @relation(fields: [contaBancariaId], references: [id])
  data            DateTime
  descricao       String
  tipo            TipoMovimentacao
  valor           Decimal          @db.Decimal(12, 4)
  conciliado      Boolean          @default(false)
  createdAt       DateTime         @default(now())
}

enum UserRole {
  DONO
  PARCEIRO
  GERENTE
}

enum CategoriaCompra {
  MATERIA_PRIMA
  INSUMO
  DESPESA_OPERACIONAL
  DESPESA_ADMINISTRATIVA
  OUTROS
}

enum CondicaoPagamento {
  A_VISTA
  A_PRAZO
  PARCELADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  BOLETO
  TRANSFERENCIA
  CHEQUE
  CARTAO_CREDITO
  CARTAO_DEBITO
}

enum StatusPagamento {
  A_PAGAR
  PAGO
  VENCIDO
}

enum UnidadeMedida {
  CAIXA
  KG
  UNIDADE
  SACO
  LITRO
  DUZIA
  FARDO
}

enum StatusProducao {
  RASCUNHO
  FINALIZADO
}

enum AmbienteNF {
  PRODUCAO
  HOMOLOGACAO
}

enum StatusNF {
  RASCUNHO
  AUTORIZADA
  CANCELADA
  REJEITADA
}

enum StatusFinanceiro {
  A_RECEBER
  RECEBIDO
}

enum FormaAcerto {
  ABATIMENTO
  DEVOLUCAO_DINHEIRO
  CREDITO
}

enum StatusDevolucao {
  PENDENTE
  ACERTADA
}

enum TipoConta {
  CAIXA_FISICO
  CONTA_CORRENTE
  CONTA_POUPANCA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusRomaneio {
  EMITIDO
  CANCELADO
}

enum StatusTitulo {
  A_RECEBER
  RECEBIDO
  VENCIDO
}

enum OrigemTitulo {
  NFE
  ROMANEIO
  MANUAL
  PDV
}

model Configuracao {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

// ── FASE 3: Novos módulos ──────────────────────────────────────

model Transportadora {
  id                String    @id @default(cuid())
  nome              String
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  telefone          String?
  email             String?
  contato           String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  observacao        String?
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  pedidos           Pedido[]
}

model Pedido {
  id               String           @id @default(cuid())
  numero           Int              @default(autoincrement())
  tipo             String           @default("VENDA")
  clienteId        String?
  cliente          Cliente?         @relation(fields: [clienteId], references: [id])
  fornecedorId     String?
  fornecedor       Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  transportadoraId String?
  transportadora   Transportadora?  @relation(fields: [transportadoraId], references: [id])
  data             DateTime
  dataEntrega      DateTime?
  status           StatusPedido     @default(ABERTO)
  totalValor       Decimal          @default(0) @db.Decimal(12, 4)
  frete            Decimal          @default(0) @db.Decimal(12, 4)
  outrasTaxas      Decimal          @default(0) @db.Decimal(12, 4)
  formaPagamento   String?
  dataCobranca     DateTime?
  observacao       String?
  obsInternas      String?
  obsCliente       String?
  itens            ItemPedido[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ItemPedido {
  id         String        @id @default(cuid())
  pedidoId   String
  pedido     Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    String
  unidade    UnidadeMedida @default(CAIXA)
  quantidade Float
  valorUnit  Decimal       @db.Decimal(12, 4)
  desconto   Decimal       @default(0) @db.Decimal(12, 4)
  total      Decimal       @db.Decimal(12, 4)
}

model ControleRoca {
  id            String           @id @default(cuid())
  codigo        String?          @unique
  nome          String
  area          Float?
  localizacao   String?
  mudasPlantadas Float?
  cultura       String?
  produtorId    String?
  produtor      Produtor?        @relation(fields: [produtorId], references: [id])
  status        StatusRoca       @default(ATIVA)
  dataPlantio   DateTime?
  dataColheita  DateTime?
  observacao    String?
  registros     RegistroRoca[]
  colheitas     ColheitaDiaria[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model RegistroRoca {
  id            String        @id @default(cuid())
  rocaId        String
  roca          ControleRoca  @relation(fields: [rocaId], references: [id], onDelete: Cascade)
  data          DateTime
  tipo          TipoRegistroRoca
  descricao     String
  custo         Decimal       @default(0) @db.Decimal(12, 4)
  createdAt     DateTime      @default(now())
}

enum StatusPedido {
  ABERTO
  CONFIRMADO
  ENTREGUE
  CANCELADO
  PAGO
}

enum StatusRoca {
  ATIVA
  COLHIDA
  POUSIO
  ABANDONADA
}

enum TipoRegistroRoca {
  PLANTIO
  ADUBACAO
  IRRIGACAO
  DEFENSIVO
  COLHEITA
  OUTRO
}

model LancamentoCusto {
  id                String    @id @default(cuid())
  produtorId        String?
  rocaId            String?
  data              DateTime
  combustivel       Decimal   @default(0) @db.Decimal(12, 4)
  bandejaEmbalagem  Decimal   @default(0) @db.Decimal(12, 4)
  valesDinheiro     Decimal   @default(0) @db.Decimal(12, 4)
  creditos          Decimal   @default(0) @db.Decimal(12, 4)
  debitosAnteriores Decimal   @default(0) @db.Decimal(12, 4)
  observacao        String?
  createdAt         DateTime  @default(now())
}

/// Documento fotografado pelo celular e lido por OCR (Leitor de Documentos).
/// A foto é armazenada como data URL (base64) reduzida; `campos` guarda a
/// "planilha" extraída — array de { campo, valor } editável pelo usuário.
model DocumentoDigitalizado {
  id         String   @id @default(cuid())
  nome       String                              // rótulo do documento (ex.: "Nota Sítio 12/07")
  imagem     String?  @db.Text                   // foto reduzida em data URL (base64)
  textoBruto String?  @db.Text                   // texto completo devolvido pelo OCR
  campos     Json     @default("[]")             // [{ campo: string, valor: string }]
  total      Decimal? @db.Decimal(14, 2)         // maior valor monetário detectado (palpite de total)
  userId     String?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
}
